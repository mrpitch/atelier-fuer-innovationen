# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=

# Or use an Anthropic API key instead — uncomment and fill in either this or
# the token above, not both.
# ANTHROPIC_API_KEY=

# TODO: add any env vars this repo's issue tracker or other tooling needs
# inside the sandbox (e.g. a scoped API token). Nothing here is read from
# the host's shell environment — the container only sees what's in this file.

# Colima Docker socket. Set this before running any `sandcastle docker *` command.
# Replace <username> with your macOS username.
# Run `colima start` before using Sandcastle.
# DOCKER_HOST=unix:///Users/<username>/.colima/default/docker.sock

# GitHub token — required to clone @mrpitch/sandcastle during the Docker image
# build. This does NOT go in this file (it is a build-time secret, not a
# container runtime env var). Pass it at build time via:
#
#   GITHUB_TOKEN=your_token pnpm run sandcastle:build
#
# which forwards it as a BuildKit secret (--secret id=github_token,env=GITHUB_TOKEN).
# The token is never written to an image layer. See .sandcastle/README.md for
# the required Dockerfile RUN step and full setup instructions.
