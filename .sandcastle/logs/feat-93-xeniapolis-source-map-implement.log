Let me do a quick exploratory crawl first to understand the full scope of the site before writing the committed script.
Bash(cat > /tmp/explore-crawl.mjs << 'EOF'
const ORIGIN = 'https://xeniapolis.de'
const seen = new Set()
const queue = ['/']
const pages = []
const assetsSet = new Set()
const externals = new Set()

function resolve(base, href) {
  try { return new URL(href, base).toString() } catch { return null }
}

function extractHrefs(html) {
  const out = []
  const re = /(?:href|src)\s*=\s*["']([^"']+)["']/gi
  let m
  while ((m = re.exec(html))) out.push(m[1])
  return out
}

let count = 0
while (queue.length && count < 500) {
  const url = queue.shift()
  if (seen.has(url)) continue
  seen.add(url)
  count++
  let res
  try {
    res = await fetch(url, { redirect: 'follow' })
  } catch (e) {
    pages.push({ url, status: 'ERR:' + e.message })
    continue
  }
  const status = res.status
  const ct = res.headers.get('content-type') || ''
  if (!ct.includes('text/html')) {
    pages.push({ url, status, ct, skipBody: true })
    continue
  }
  const html = await res.text()
  const titleMatch = html.match(/<title>([^<]*)<\/title>/i)
  pages.push({ url, status, title: titleMatch ? titleMatch[1] : null })
  const refs = extractHrefs(html)
  for (const href of refs) {
    if (/^(javascript:|mailto:|#)/i.test(href)) continue
    const abs = resolve(url, href)
    if (!abs) continue
    const u = new URL(abs)
    if (u.hostname !== 'xeniapolis.de') { externals.add(abs); continue }
    const clean = abs.split('#')[0]
    if (/\.(html?|php)$/i.test(u.pathname) || u.pathname.endsWith('/')) {
      if (!seen.has(clean)) queue.push(clean)
    } else {
      assetsSet.add(clean)
    }
  }
}

console.log('TOTAL_PAGES', pages.length)
console.log('TOTAL_ASSETS', assetsSet.size)
console.log('TOTAL_EXTERNAL', externals.size)
console.log('---STATUSES---')
const statusCounts = {}
for (const p of pages) statusCounts[p.status] = (statusCounts[p.status]||0)+1
console.log(JSON.stringify(statusCounts))
console.log('---SAMPLE PAGES---')
console.log(pages.slice(0,20).map(p=>p.url+' ['+p.status+'] '+(p.title||'')).join('\n'))
EOF
timeout 100 node /tmp/explore-crawl.mjs 2>&1 | tail -60)
