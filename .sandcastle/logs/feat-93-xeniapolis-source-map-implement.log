Bash(timeout 90 node -e "
const ORIGIN = 'https://xeniapolis.de'
const ASSET_EXT = new Set(['gif','jpg','jpeg','png','bmp','ico','wav','mid','midi','class','css','js','swf','mov','avi'])
const visited = new Set()
const queue = [ORIGIN + '/']
const unknownExts = new Set()
const noExtNonSlash = new Set()

async function fetchHtml(url) {
  try {
    const res = await fetch(url, { redirect: 'follow' })
    const ct = res.headers.get('content-type') || ''
    if (!ct.toLowerCase().includes('html')) return null
    const buf = await res.arrayBuffer()
    return new TextDecoder('iso-8859-1').decode(buf)
  } catch { return null }
}

while (queue.length) {
  const url = queue.shift()
  if (visited.has(url)) continue
  visited.add(url)
  const html = await fetchHtml(url)
  if (!html) continue
  const re = /(?:href|src|background)\s*=\s*[\"']([^\"']*)[\"']/gi
  let m
  while ((m = re.exec(html))) {
    const raw = m[1].trim()
    if (!raw || raw.startsWith('#')) continue
    if (/^(javascript|mailto|tel):/i.test(raw)) continue
    if (/[<>]|%3c|%3e/i.test(raw)) continue
    let resolved
    try { resolved = new URL(raw, url) } catch { continue }
    if (resolved.hostname !== 'xeniapolis.de') continue
    resolved.hash = ''
    const extMatch = resolved.pathname.match(/\.([a-z0-9]+)\$/i)
    if (extMatch) {
      const ext = extMatch[1].toLowerCase()
      if (!/^html?$|^php$/i.test(ext) && !ASSET_EXT.has(ext)) unknownExts.add(ext + ' -> ' + resolved.pathname)
    } else if (!resolved.pathname.endsWith('/')) {
      noExtNonSlash.add(resolved.pathname)
    }
    const u = resolved.toString()
    if (!visited.has(u) && (/\.html?\$|\.php\$/i.test(resolved.pathname) || resolved.pathname.endsWith('/'))) queue.push(u)
  }
}
console.log('visited pages:', visited.size)
console.log('unknown extensions:', [...unknownExts])
console.log('no-extension non-slash paths:', [...noExtNonSlash])
"
)
