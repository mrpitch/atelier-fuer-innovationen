{
	"name": "atelier-fuer-innovationen",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"build": "next build && next-image-export-optimizer",
		"dev": "next dev",
		"start": "npx serve@latest out",
		"nuke": "rm -r node_modules; rm -r pnpm-lock.yaml",
		"postinstall": "fumadocs-mdx",
		"prepare": "husky",
		"afk": "tsx --env-file=.sandcastle/.env scripts/run-sandcastle.ts",
		"test": "tsx --test scripts/*.test.ts",
		"validate:okf": "tsx scripts/validate-okf.ts",
		"validate:content": "tsx scripts/validate-content.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "next typegen && tsc --noEmit",
		"sandcastle:build": "DOCKER_BUILDKIT=1 docker build --secret id=npmrc,src=.npmrc --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) -t sandcastle:atelier-fuer-innovationen -f .sandcastle/Dockerfile ."
	},
	"dependencies": {
		"@fumadocs/base-ui": "^16.15.0",
		"class-variance-authority": "^0.7.1",
		"fumadocs-core": "^16.15.0",
		"fumadocs-mdx": "^15",
		"fumadocs-typescript": "^5",
		"lucide-react": "^0.475.0",
		"next": "^16",
		"next-image-export-optimizer": "^1.20.1",
		"react": "^19.2",
		"react-dom": "^19.2",
		"react-medium-image-zoom": "^5.3",
		"tailwind-merge": "^3"
	},
	"optionalDependencies": {
		"vite": "*"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "^0.12.0",
		"@fumadocs/cli": "^1",
		"@playwright/mcp": "^0.0.79",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/mdx": "^2.0.13",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^9",
		"eslint-config-next": "^16",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"postcss": "^8",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^5",
		"zod": "^4.4.3"
	}
}
