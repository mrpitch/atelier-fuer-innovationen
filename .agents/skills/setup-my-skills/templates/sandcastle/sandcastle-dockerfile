# syntax=docker/dockerfile:1
FROM node:24-alpine

RUN apk add --no-cache git curl jq bash \
  && corepack enable

# Build-args for UID/GID alignment: the scaffolded `sandcastle:build`
# package.json script passes these as the host user's UID/GID (via `id -u`/
# `id -g`) so image-built files and bind-mounted files share an owner
# without runtime chown.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Rename the base image's "node" user to "agent" and align UID/GID.
# (shadow is installed just long enough to run groupmod/usermod, then
# removed — Alpine's busybox tools don't support UID/GID reassignment.)
RUN apk add --no-cache shadow \
  && groupmod -o -g $AGENT_GID node \
  && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node \
  && apk del shadow

USER ${AGENT_UID}:${AGENT_GID}

# /implement's own flow ends with a commit, run inside this container on the
# bind-mounted repo (see run-sandcastle.ts) — git needs an identity to commit
# as. No GitHub credentials here regardless: this only covers the local
# `git commit`; push and PR creation stay host-side.
ENV GIT_AUTHOR_NAME="Sandcastle Agent"
ENV GIT_AUTHOR_EMAIL="sandcastle-agent@localhost"
ENV GIT_COMMITTER_NAME="Sandcastle Agent"
ENV GIT_COMMITTER_EMAIL="sandcastle-agent@localhost"

# Install Claude Code CLI via the official install script
RUN curl -fsSL https://claude.ai/install.sh | bash

ENV PATH="/home/agent/.local/bin:$PATH"

# In head-branch sandbox mode, sandcastle bind-mounts the host's already
# checked-out git worktree at /home/agent/workspace, overriding whatever is
# copied in below. The COPY + install here still matter: they bake
# dependencies into the image at build time so `docker build` and a
# standalone `docker run` (no bind mount, no network) can be used to verify
# the image on its own, and they seed a warm package-manager store for
# iterations where the bind-mounted node_modules is missing or stale.
WORKDIR /home/agent/workspace
# REPLACE_WITH_LOCKFILE_COPY — setup-my-skills fills this in to match this
# repo's package manager, e.g. "COPY --chown=${AGENT_UID}:${AGENT_GID}
# package.json pnpm-lock.yaml ./" for pnpm, or the package-lock.json /
# yarn.lock equivalent.
COPY --chown=${AGENT_UID}:${AGENT_GID} REPLACE_WITH_LOCKFILE_COPY ./
# REPLACE_WITH_INSTALL_COMMAND — e.g. "RUN pnpm install --frozen-lockfile",
# "RUN npm ci", or "RUN yarn install --frozen-lockfile".
#
# Private package registry (a scoped registry entry in .npmrc/.yarnrc.yml
# carrying a real auth token): don't COPY that file in — .dockerignore
# excludes it, and a plain COPY would bake the token into this layer
# permanently, readable from the image forever after. Mount it as a build
# secret instead, scoped to this one RUN, never written to a layer:
#   RUN --mount=type=secret,id=npmrc,target=/home/agent/workspace/.npmrc,uid=${AGENT_UID},gid=${AGENT_GID} \
#     REPLACE_WITH_INSTALL_COMMAND
# and pass it at build time: `docker build --secret id=npmrc,src=.npmrc ...`
# (requires DOCKER_BUILDKIT=1 and the `# syntax` line at the top of this
# file, both already in place here). setup-my-skills' scaffold offer writes
# this variant automatically when it detects a live token in a tracked
# .npmrc/.yarnrc.yml; this comment documents it for a manual edit otherwise.
RUN REPLACE_WITH_INSTALL_COMMAND
COPY --chown=${AGENT_UID}:${AGENT_GID} . .

ENTRYPOINT ["sleep", "infinity"]
