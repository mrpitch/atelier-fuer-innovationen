# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=

# Or use an Anthropic API key instead — uncomment and fill in either this or
# the token above, not both.
# ANTHROPIC_API_KEY=

# TODO: add any env vars this repo's issue tracker or other tooling needs
# inside the sandbox (e.g. a scoped API token). Nothing here is read from
# the host's shell environment — the container only sees what's in this file.

# macOS + Colima only: point Docker at the Colima socket before running any
# `sandcastle docker *` command. Replace <username> with your macOS username,
# and run `colima start` first. Not needed on Linux or Docker Desktop.
# DOCKER_HOST=unix:///Users/<username>/.colima/default/docker.sock
